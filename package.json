{
  "name": "vue-ex-ui",
  "version": "0.3.6",
  "type": "module",
  "description": "",
  "files": [
    "dist"
  ],
  "main": "./dist/ex-ui.umd.cjs",
  "module": "./dist/ex-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ex-ui.js",
      "require": "./dist/ex-ui.umd.cjs"
    },
    "./style.css": "./dist/ex-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" --max-warnings=200",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "generate-docs": "node scripts/generate-component-docs.js",
    "create-component": "node scripts/create-component.js",
    "prepublishOnly": "npm run build && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "vue3",
    "typescript",
    "component-library",
    "cyberpunk",
    "ui-components"
  ],
  "author": "Ex UI Team",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-i18n": "^11.1.12"
  },
  "dependencies": {
    "@fontsource/audiowide": "^5.2.7",
    "echarts": "^6.0.0",
    "jsbarcode": "^3.12.1",
    "lunar-javascript": "^1.7.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "9.1.7",
    "eslint-plugin-vue": "^10.4.0",
    "fast-check": "^4.5.3",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.92.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "^11.1.12"
  },
  "sideEffects": [
    "*.css"
  ]
}
