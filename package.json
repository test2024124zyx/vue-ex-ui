{
  "name": "vue-ex-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 cyberpunk-styled UI component library with TypeScript support",
  "files": [
    "dist"
  ],
  "main": "./dist/ex-ui.cjs",
  "module": "./dist/ex-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ex-ui.js",
      "require": "./dist/ex-ui.cjs"
    },
    "./style.css": "./dist/ex-ui.css",
    "./base.css": "./dist/es/assets/style-base.css",
    "./font.css": "./dist/es/assets/style-font.css",
    "./es": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./es/components/*": {
      "types": "./dist/es/components/*/index.d.ts",
      "import": "./dist/es/components/*/index.js"
    },
    "./es/*": {
      "types": "./dist/es/*.d.ts",
      "import": "./dist/es/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:full && npm run build:es",
    "build:full": "vite build",
    "build:es": "vite build --config vite.config.es.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" --max-warnings=10",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build && npm run typecheck && npm run verify:package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "vue3",
    "typescript",
    "component-library",
    "cyberpunk",
    "ui-components"
  ],
  "author": "Ex UI Team",
  "license": "MIT",
  "peerDependencies": {
    "echarts": "^6.0.0",
    "jsbarcode": "^3.12.1",
    "lunar-javascript": "^1.7.6",
    "qrcode": "^1.5.4",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.12"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "jsbarcode": {
      "optional": true
    },
    "lunar-javascript": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource/audiowide": "^5.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "echarts": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "fast-check": "^4.5.3",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsbarcode": "^3.12.1",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.4",
    "lunar-javascript": "^1.7.6",
    "prettier": "^3.6.2",
    "qrcode": "^1.5.4",
    "sass-embedded": "^1.92.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "^11.1.12"
  },
  "sideEffects": [
    "**/*.css",
    "*.css"
  ]
}
