# Normalize line endings to LF in the repo for all text files.
# Prevents the CRLF churn seen on Windows checkouts.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.ico binary
